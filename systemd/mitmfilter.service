[Unit]
Description=Bilibili Knowledge Gate (mitmproxy addon)
After=network-online.target kb-judge.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
Environment=HOME=/root
Environment=KB_JUDGE_URL=http://127.0.0.1:8090
Environment=KB_RULES_DIR=/opt/kbjudge
Environment=KB_PROXY_PORT=8080
# KB_PROXY_HOST 不设则自动探测本机 IP（PAC 客户端要用）
# Environment=KB_PROXY_HOST=192.168.1.10
Environment=KB_WEB_GATE=confident
Environment=KB_WEB_WAIT=4
Environment=KB_WEB_INJECT=1
Environment=KB_WEB_DEBUG=0
Environment=KB_HIDE_NON_KNOWLEDGE=0
# 出口不可达（境内网络限制）的域名：直接快速失败，返回说明页而不是裸 502
Environment=KB_EGRESS_BLOCKED=google.com,googleapis.com,gstatic.com,googlesyndication.com,googleadservices.com,doubleclick.net,googletagmanager.com,google-analytics.com,googlevideo.com,youtube.com,youtu.be,facebook.com,fbcdn.net,instagram.com,twitter.com,x.com,tiktok.com,telegram.org,t.me,reddit.com,pinterest.com,wikipedia.org,wikimedia.org,netflix.com,spotify.com,whatsapp.com,dropbox.com,yandex.ru,dailymotion.com,vimeo.com,zoom.us,discord.com,discordapp.com
# connection_strategy=lazy: 先建立隧道再连上游，出口不可达时才能返回友好说明页
ExecStart=/usr/local/bin/mitmdump -p 8080 -s /opt/mitmproxy/bilibili_filter.py --set termlog_verbosity=info --set block_global=false --set connection_strategy=lazy
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
