# ============================================================================
#  Bilibili Knowledge Gate - 环境变量模板
#  复制到 /etc/kb-gate/gate.env，然后按需修改；install.sh 会读取它
#  改完： systemctl restart mitmfilter kb-judge
# ============================================================================

# ---------------------------------------------------------------- 监听地址
# 代理端口（客户端用它连进来）
KB_PROXY_PORT=8080
# PAC / CA 下载服务端口
KB_CA_PORT=8081
# CA 下载服务绑定地址（0.0.0.0 = 所有网卡）
KB_CA_BIND=0.0.0.0

# 对外 IP：不填则由插件自动探测本机 IP（PAC 客户端要用）
# KB_PROXY_HOST=192.168.1.10

# 内网网段（PAC 里只有该网段走代理；留空 = 全部走代理）
# KB_LAN_NET=192.168.1.0
# KB_LAN_MASK=255.255.255.0

# ---------------------------------------------------------------- 目录
KB_HOME=/opt/kbjudge
KB_RULES_DIR=/opt/kbjudge
KB_JUDGE_DB=/opt/kbjudge/verdicts.db
KB_WEB_ALLOW_FILE=/opt/kbjudge/web_allow.txt
KB_AUDIT_DIR=/opt/kbjudge/audit

# ---------------------------------------------------------------- 裁决服务
KB_JUDGE_PORT=8090
KB_JUDGE_URL=http://127.0.0.1:8090

# LLM 后端（opencode serve）
KB_OC_URL=http://127.0.0.1:4096

# 模型链（按顺序降级；逗号分隔）。免费模型可用 `opencode models` 查看
KB_MODELS=opencode/glm-5.3-flash-free,opencode/nemotron-3.5-lightning-free,opencode/deepseek-v4.1-flash-free
KB_WEB_MODELS=opencode/glm-5.3-flash-free,opencode/nemotron-3.5-lightning-free

# 单次 LLM 超时 / 整体裁决截止时间（秒）
KB_LLM_TIMEOUT=25
KB_LLM_DEADLINE=70

# ---------------------------------------------------------------- 网页门禁
# off        = 只按规则放行/拦截，不做 LLM 判定（最快）
# confident  = 未知站点先等 LLM 判定，等不到再放行（默认）
# strict     = 未知站点必须等 LLM 结论，否则一直显示"判定中"
KB_WEB_GATE=confident
# 未知站点最多等待多少秒
KB_WEB_WAIT=4
# 是否在放行的网页里注入"判定中"提示条
KB_WEB_INJECT=1
# 调试日志（0=关，1=开）
KB_WEB_DEBUG=0

# ---------------------------------------------------------------- 出口不可达
# 这些域名从本机出口连不上（境内网络限制）。命中后代理直接返回"出口不可达"说明页，
# 避免浏览器看到裸 502 或长时间挂起。留空可关闭该功能。
# KB_EGRESS_BLOCKED=google.com,youtube.com,facebook.com,twitter.com,x.com,instagram.com,tiktok.com,telegram.org,reddit.com,wikipedia.org,netflix.com

# ---------------------------------------------------------------- 展示层
# 1 = 首页只保留"知识类"卡片（其余隐藏）
KB_HIDE_NON_KNOWLEDGE=0
# 学科推荐：数学/物理 优先
KB_SUBJECT_PRIORITY=math,physics
